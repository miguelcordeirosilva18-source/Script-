-- BUSCAR SERVIDORES
local function GetServers()

	local Servers = {}
	local Cursor = ""

	for Page = 1,3 do

		local URL =
			"https://games.roblox.com/v1/games/"
			.. PlaceId
			.. "/servers/Public?sortOrder=Desc&limit=100"

		if Cursor ~= "" then
			URL = URL .. "&cursor=" .. HttpService:UrlEncode(Cursor)
		end

		local Success, Response = pcall(function()
			return game:HttpGet(URL)
		end)

		if not Success then
			return nil
		end

		local OK, Data = pcall(function()
			return HttpService:JSONDecode(Response)
		end)

		if not OK or not Data then
			return nil
		end

		for _, Server in ipairs(Data.data or {}) do

			if Server.id ~= game.JobId
			and Server.playing
			and Server.maxPlayers
			and Server.playing < Server.maxPlayers then

				table.insert(Servers,Server)

			end
		end

		Cursor = Data.nextPageCursor

		if not Cursor then
			break
		end
	end

	return Servers
end

-- ENCONTRAR SERVIDOR
local function FindServer(Mode)

	Status.Text = "🔎 Procurando servidor..."

	OneButton.Active = false
	FewButton.Active = false
	ManyButton.Active = false

	local Servers = GetServers()

	if not Servers then

		Status.Text = "❌ Erro ao buscar servidores."

		OneButton.Active = true
		FewButton.Active = true
		ManyButton.Active = true

		return
	end

	local Selected = nil

	-- 1 JOGADOR
	if Mode == "One" then

		for _,Server in ipairs(Servers) do

			if Server.playing == 1 then
				Selected = Server
				break
			end

		end

	-- POUCOS
	elseif Mode == "Few" then

		local Lowest = math.huge

		for _,Server in ipairs(Servers) do

			if Server.playing <= POUCOS_MAX
			and Server.playing < Lowest then

				Lowest = Server.playing
				Selected = Server

			end

		end

	-- MUITOS
	elseif Mode == "Many" then

		local Highest = -1

		for _,Server in ipairs(Servers) do

			if Server.playing >= MUITOS_MIN
			and Server.playing > Highest then

				Highest = Server.playing
				Selected = Server

			end

		end
	end

	-- NÃO ENCONTROU
	if not Selected then

		if Mode == "One" then
			Status.Text = "⚠️ Nenhum servidor com exatamente 1 jogador."

		elseif Mode == "Few" then
			Status.Text = "⚠️ Nenhum servidor com poucos jogadores."

		else
			Status.Text = "⚠️ Nenhum servidor com muitos jogadores."
		end

		OneButton.Active = true
		FewButton.Active = true
		ManyButton.Active = true

		return
	end

	-- TELEPORTAR
	Status.Text =
		"🚀 Entrando... "
		.. tostring(Selected.playing)
		.. " jogador(es)"

	task.wait(0.5)

	local Success = pcall(function()

		TeleportService:TeleportToPlaceInstance(
			PlaceId,
			Selected.id,
			Player
		)

	end)

	if not Success then

		Status.Text = "❌ Falha no teleporte."

		OneButton.Active = true
		FewButton.Active = true
		ManyButton.Active = true

	end
end

